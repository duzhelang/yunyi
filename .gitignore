# ==================================
# 🔥 系统 & IDE 配置缓存（强制忽略）
# ==================================
# IDEA 相关
.idea/
*.iml
*.iws
*.ipr
*.compiler
*.codeStyles
*.run

# Eclipse / STS 相关
.settings/
.classpath
.project
.cproject

# VS Code 相关
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# 操作系统垃圾文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# ==================================
# 📝 日志文件（强制忽略）
# ==================================
*.log
logs/
**/logs/
tomcat-log/
catalina.out
error_log
access_log

# ==================================
# ☕ 后端 Java / Maven（强制忽略）
# ==================================
# Maven 编译输出
**/target/
target/
**/test-output/
out/

# Maven 包装器缓存
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# 打包产物
*.war
*.jar
!*-sources.jar
!*-javadoc.jar

# 🔥 核心：文件上传/头像目录（本地保留，绝不推送到GitHub）
files/
**/files/
upload/
**/upload/
tmp/
temp/

# 环境配置文件
application-dev.yml
application-prod.yml
*.local.yml

# ==================================
# 🎨 前端 Vue / npm / yarn（强制忽略）
# ==================================
# 第三方依赖
node_modules/
**/node_modules/

# 构建打包产物
dist/
**/dist/
build/
**/build/

# 构建缓存
**/.cache/
**/.vite/
**/.nuxt/

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 依赖锁定文件（保留，保证环境一致）
# package-lock.json
# yarn.lock

# ==================================
# 🐍 Python AI 模型模块（强制忽略）
# ==================================
# 字节码缓存
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/
ENV/

# 安装缓存
*.egg-info/
*.egg
.pyre/
.spyproject/
.ipynb_checkpoints/

