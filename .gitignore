# ==================================
# 📊 数据集 & 临时数据（强制忽略）
# ==================================
data/
datasets/
raw_data/
python/data/
OnlinePredict/

# JSON 下载目录（本地生成，不推送）
json/
mock/

# ==================================
# 🗄️ 数据库备份文件（强制忽略）
# ==================================
*-backup.sql
*-备用.sql
*-copy.sql
*.sql.bak
*.sql.gz
*.sql.zip

# ==================================
# 🖼️ 静态资源 & 媒体文件（智能过滤）
# ==================================
# 忽略自动生成的图片/视频（头像、上传文件）
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.svg
*.mp4
*.avi
*.mov
*.mkv
*.mp3

# 排除大视频文件
1111.mp4
# 排除其他可能的大文件
*.mp4
*.zip
*.tar.gz

# ✅ 放行：前端源码素材（logo、图标、背景图）
!/vue/src/assets/**/*
!/vue/public/**/*

# ✅ 放行：项目文档（答辩/开发必备）
!*.md
!*.docx
!*.pdf
!*.pptx
!README.md

# ==================================
# 📦 压缩包 & 杂项（强制忽略）
# ==================================
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2

# ==================================
# 🚀 项目专属（糖尿病诊断系统）
# ==================================
# Tomcat 部署缓存
work/
work-Catalina/

# 系统生成的临时文件
generated/
tempfiles/


