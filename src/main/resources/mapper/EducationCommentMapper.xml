<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oda.springboot.mapper.EducationCommentMapper">

    <resultMap id="BaseResultMap" type="com.oda.springboot.entity.EducationComment">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="user_name" property="userName"/>
        <result column="content" property="content"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 查询所有留言（按创建时间倒序） -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM education_comment
        WHERE is_deleted = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据ID查询单条留言 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM education_comment
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <!-- 新增留言 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO education_comment (
            user_id, user_name, content
        ) VALUES (
            #{userId}, #{userName}, #{content}
        )
    </insert>

    <!-- 根据ID删除（逻辑删除） -->
    <update id="deleteById">
        UPDATE education_comment SET is_deleted = 1 WHERE id = #{id}
    </update>

</mapper>
